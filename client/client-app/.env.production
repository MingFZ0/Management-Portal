# Names must start with REACT_APP_ for React to automatically pick them up
#Replace localhost:5005 with the server IP or server name in production and the root of the API routes
REACT_APP_API_URL=localhost:5005
REACT_APP_ROOT=client-app
#Vite versions
VITE_API_URL=localhost:5005/pharma/hr/api
VITE_ROOT=/pharma/hr